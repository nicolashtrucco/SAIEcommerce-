# Postgres
POSTGRES_DB=sai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# API
API_PORT=3000
VITE_API_BASE_URL=http://localhost:3000
VITE_MAX_IMAGE_SIZE_MB=3
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_ADMIN_EMAIL=

# Frontend container (nginx)
FRONTEND_PORT=8080

# Backend env (for docker compose service)
BACKEND_CORS_ORIGIN=*
BACKEND_MAX_IMAGE_SIZE_MB=3
BACKEND_FIREBASE_PROJECT_ID=
BACKEND_FIREBASE_CLIENT_EMAIL=
BACKEND_FIREBASE_PRIVATE_KEY=
BACKEND_FIREBASE_STORAGE_BUCKET=
BACKEND_ADMIN_EMAIL=
BACKEND_ADMIN_UID=

# Mail / Nodemailer (backend)
BACKEND_SMTP_HOST=
BACKEND_SMTP_PORT=587
BACKEND_SMTP_SECURE=false
BACKEND_SMTP_USER=
BACKEND_SMTP_PASS=
# Opcionales (si se dejan vacias, se usa BACKEND_SMTP_USER)
BACKEND_SMTP_FROM=
BACKEND_CONTACT_TO_EMAIL=
